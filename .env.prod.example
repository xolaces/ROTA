# =============================================================
# ROTA — PRODUCTION environment for docker-compose.prod.yml.
# Copy to .env ON THE SERVER and fill in real values.
# .env is gitignored — NEVER commit the filled-in copy.
# Generate strong secrets with:  openssl rand -base64 24
# =============================================================

# ---- Postgres ----
POSTGRES_DB=rota
POSTGRES_USER=rota_user
POSTGRES_PASSWORD=

# ---- Redis ----
REDIS_PASSWORD=

# ---- JWT (RS256) ----
JWT_ISSUER=rota
JWT_AUDIENCE=rota-client
# Paste each PEM as a SINGLE UNQUOTED line with literal \n between rows — the API normalizes \n back to
# real newlines (PemKey.Normalize), so a multi-line PEM fits in this single-line .env value. Produce it from
# your .pem with:   awk 'NR>1{printf "\\n"}{printf "%s",$0}' keys/jwt_private.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ---- Seed admin (created on first boot) ----
SEED_ADMIN_PASSWORD=
# Optional — your real admin email/username. Defaults: admin@rota.local / "Owner".
# To use these, also add  Seed__AdminEmail: ${SEED_ADMIN_EMAIL}  under the api service in the compose file.
# SEED_ADMIN_EMAIL=

# ---- Beta gate (true = registration requires a beta key) ----
BETA_GATE_ENABLED=true

# ---- Operator email (optional; Gmail app password). Blank → sending is skipped, rows still persist. ----
EMAIL_USERNAME=
EMAIL_PASSWORD=
