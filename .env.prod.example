# =============================================================
# ROTA — PRODUCTION environment for docker-compose.prod.yml.
# Copy to .env ON THE SERVER and fill in real values.
# .env is gitignored — NEVER commit the filled-in copy.
# Generate strong secrets with:  openssl rand -base64 24
# =============================================================

# ---- Postgres ----
POSTGRES_DB=rota
POSTGRES_USER=rota_user
POSTGRES_PASSWORD=

# ---- Redis ----
REDIS_PASSWORD=

# ---- JWT (RS256) ----
JWT_ISSUER=rota
JWT_AUDIENCE=rota-client
# Paste each PEM as a SINGLE UNQUOTED line with literal \n between rows — the API normalizes \n back to
# real newlines (PemKey.Normalize), so a multi-line PEM fits in this single-line .env value. Produce it from
# your .pem with:   awk 'NR>1{printf "\\n"}{printf "%s",$0}' keys/jwt_private.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ---- Seed admin (created on first boot) ----
SEED_ADMIN_PASSWORD=
# Name + email for the bootstrap admin (defaults: "Owner" / admin@rota.local). Seeding bypasses the
# reserved-name rule, so a staff handle like DEV_Xolaces is allowed here.
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
# Make a developer account: grants the Developer flag + locks the account into the hidden "Dev Coffee
# Shop" guild on boot. Set to the SEED_ADMIN_USERNAME to make the admin itself a dev. Blank = none.
DEV_USERNAME=

# ---- Beta gate (true = registration requires a beta key) ----
BETA_GATE_ENABLED=true

# ---- Email (SMTP). EMAIL_ENABLED=false → nothing is sent, and password reset answers 503 until it can
#      be (rows still persist + show in the dashboard as Skipped). To send (password-reset codes +
#      report/mod notifications): set EMAIL_ENABLED=true, the SMTP login, and the from/operator addresses.
#      Many hosts block outbound 25, 465 and 587. If yours does, use a relay's alternate port
#      (often 2525) through EMAIL_HOST and EMAIL_PORT. The from address must be one the relay accepts. ----
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_OPERATOR=
